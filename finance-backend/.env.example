# Render Deployment Environment Variables

# Server Port (Render sets this automatically)
PORT=5001

# Database Connection (Get this from Render Dashboard -> PostgreSQL -> External/Internal Connection String)
# For Render Web Service, use Internal Connection String.
# For local testing with Render DB, use External Connection String.
DATABASE_URL=postgres://user:password@host:port/dbname?ssl=true

# JWT Secret
JWT_SECRET=your_secure_random_secret_key

# CORS / Frontend URL
FRONTEND_URL=https://your-frontend-url.onrender.com

# Node Environment
NODE_ENV=production
