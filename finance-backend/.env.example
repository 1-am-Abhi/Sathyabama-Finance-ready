# Render Deployment Environment Variables

# Server Port (Render sets this automatically)
PORT=5001

# Database Connection (Get this from Render Dashboard -> PostgreSQL -> External/Internal Connection String)
# For Render Web Service, use Internal Connection String.
# For local testing with Render DB, use External Connection String.
DATABASE_URL=postgres://user:password@host:port/dbname?ssl=true

# JWT Secret
JWT_SECRET=your_secure_random_secret_key

# CORS / Frontend URL
FRONTEND_URL=https://your-frontend-url.onrender.com

# Node Environment
NODE_ENV=production

# Claude AI (server-side proxy for the AI features). Without this key the AI
# endpoints return 503 (AI_UNAVAILABLE) and the UI degrades gracefully.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to claude-opus-4-8)
# AI_MODEL=claude-opus-4-8

# Installment proof-gating (defaults shown). Set PROOF_GATING_ENABLED=false to disable.
# PROOF_GATING_ENABLED=true
# PROOF_DEADLINE_DAYS=30

# Redis (required in production for sockets + BullMQ disbursement worker)
# REDIS_URL=rediss://...
# SCOPUS_API_KEY=...
